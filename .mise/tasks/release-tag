#!/usr/bin/env bash
#MISE description="Create release tag"
#MISE depends=["build-all"]

if [ $# -ne 1 ]; then
  echo "Usage: $0 <version>"
  echo "Example: $0 0.1.0"
  exit 1
fi

VERSION=$1

# バージョン形式チェック
if ! [[ $VERSION =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "Error: Invalid version format. Use semantic versioning (e.g., 0.1.0)"
  exit 1
fi

git tag -a "v$VERSION" -m "Release v$VERSION"
git push --tags

echo "Release tag v$VERSION has been created and pushed."
echo "You can now install this version with:"
echo "go install github.com/haryoiro/oasc/cmd/oasc@v$VERSION"
