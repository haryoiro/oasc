#!/usr/bin/env bash
#MISE description="Create release tag"

if [ $# -ne 1 ]; then
  echo "Usage: $0 <version>"
  echo "Example: $0 0.1.0"
  exit 1
fi

export VERSION=$1

# バージョン形式チェック
if ! [[ $VERSION =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "Error: Invalid version format. Use semantic versioning (e.g., 0.1.0)"
  exit 1
fi

# タグ作成・push・インストール案内関数
tag_and_push() {
  git tag -a "v$VERSION" -m "Release v$VERSION"
  git push --tags
  echo "Release tag v$VERSION has been created and pushed."
  echo "You can now install this version with:"
  echo "go install github.com/haryoiro/oasc/cmd/oasc@v$VERSION"
}

# 前回のタグを取得
export tags=$(git tag --list 'v*' --sort=-v:refname)
git tag --list 'v*' --sort=-v:refname
echo $tags
export PREV_TAG=$(echo "$tags" | grep -v "v$VERSION" | head -n 1)

if [ -z "$PREV_TAG" ]; then
  tag_and_push
  gh release create "v$VERSION" --title "v$VERSION" --notes "Release v$VERSION"
  exit 0
fi

# # PR一覧取得（マージコミットからPR番号抽出）
export PR_LIST=$(git log --merges --pretty=format:"%s" $PREV_TAG..HEAD | grep -Eo '#[0-9]+' | sort -u)

export RELEASE_NOTES="## Merged Pull Requests since $PREV_TAG\n"
if [ -z "$PR_LIST" ]; then
  RELEASE_NOTES+="(No pull requests merged)\n"
else
  for pr in $PR_LIST; do
    RELEASE_NOTES+="- $pr\n"
  done
fi

tag_and_push

echo "Creating GitHub release with PR list..."

gh release create "v$VERSION" --title "v$VERSION" --notes "$RELEASE_NOTES"
